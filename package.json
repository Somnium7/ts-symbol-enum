{
  "name": "ts-symbol-enum",
  "version": "1.0.0",
  "description": "TypeScript Symbol Enum",
  "author": "Somnium7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somnium7/ts-symbol-enum.git"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "npx tsc",
